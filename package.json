{
  "name": "fantasyworld-auction-draft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "dotenv -e .env.local -- drizzle-kit push && npm run db:sql",
    "db:sql": "dotenv -e .env.local -- tsx scripts/apply-sql.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify.ts",
    "db:backup": "dotenv -e .env.local -- tsx scripts/backup.ts",
    "test:int": "npm run check:testdb && dotenv -e .env.local -- sh -c 'export ALLOW_DB_RESET=1 DATABASE_URL=\"$TEST_DATABASE_URL\"; npx vitest run --config vitest.integration.config.ts'",
    "smoke": "npm run check:testdb && dotenv -e .env.local -- sh -c 'export ALLOW_DB_RESET=1 DATABASE_URL=\"$TEST_DATABASE_URL\"; npx tsx scripts/smoke.ts'",
    "check:idle": "dotenv -e .env.local -- tsx scripts/check-idle.ts",
    "draft:start": "dotenv -e .env.local -- tsx scripts/start-draft.ts",
    "dev:test": "dotenv -e .env.local -- sh -c 'export ENABLE_TEST_SEATS=1 DATABASE_URL=\"$TEST_DATABASE_URL\"; next dev'",
    "pins": "dotenv -e .env.local -- tsx scripts/pins.ts",
    "recolor": "dotenv -e .env.local -- tsx scripts/recolor.ts",
    "draft:reset": "dotenv -e .env.local -- tsx scripts/reset.ts",
    "draft:record": "dotenv -e .env.local -- tsx scripts/record-picks.ts",
    "db:test-setup": "dotenv -e .env.local -- tsx scripts/setup-test-db.ts",
    "db:test-migrate": "npm run check:testdb && dotenv -e .env.local -- tsx scripts/migrate-seasons.ts -- --test && dotenv -e .env.local -- tsx scripts/migrate-queue.ts -- --test && dotenv -e .env.local -- tsx scripts/migrate-pick-ranks.ts -- --test && dotenv -e .env.local -- tsx scripts/migrate-lot-index.ts -- --test && dotenv -e .env.local -- tsx scripts/migrate-player-identity.ts -- --test --offline && npm run db:test-seed",
    "db:test-seed": "dotenv -e .env.local -- tsx scripts/seed-test.ts",
    "check:testdb": "dotenv -e .env.local -- tsx scripts/guard-test-db.ts",
    "db:migrate-auction": "dotenv -e .env.local -- tsx scripts/migrate-called-auction.ts",
    "db:migrate-seasons": "dotenv -e .env.local -- tsx scripts/migrate-seasons.ts",
    "db:migrate-queue": "dotenv -e .env.local -- tsx scripts/migrate-queue.ts",
    "db:migrate-pick-ranks": "dotenv -e .env.local -- tsx scripts/migrate-pick-ranks.ts",
    "db:migrate-lot-index": "dotenv -e .env.local -- tsx scripts/migrate-lot-index.ts",
    "db:migrate-identity": "dotenv -e .env.local -- tsx scripts/migrate-player-identity.ts",
    "news:refresh": "dotenv -e .env.local -- tsx scripts/refresh-news.ts",
    "season:new": "dotenv -e .env.local -- tsx scripts/new-season.ts",
    "season:list": "dotenv -e .env.local -- tsx scripts/list-seasons.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
