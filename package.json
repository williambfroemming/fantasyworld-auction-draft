{
  "name": "fantasyworld-auction-draft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "dotenv -e .env.local -- drizzle-kit push && npm run db:sql",
    "db:sql": "dotenv -e .env.local -- tsx scripts/apply-sql.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify.ts",
    "test:int": "npm run check:idle && ALLOW_DB_RESET=1 dotenv -e .env.local -- vitest run --config vitest.integration.config.ts",
    "smoke": "ALLOW_DB_RESET=1 dotenv -e .env.local -- tsx scripts/smoke.ts",
    "check:idle": "dotenv -e .env.local -- tsx scripts/check-idle.ts",
    "bots": "dotenv -e .env.local -- tsx scripts/bots.ts",
    "draft:start": "dotenv -e .env.local -- tsx scripts/start-draft.ts",
    "dev:test": "ENABLE_TEST_SEATS=1 next dev",
    "pins": "dotenv -e .env.local -- tsx scripts/pins.ts",
    "recolor": "dotenv -e .env.local -- tsx scripts/recolor.ts",
    "draft:reset": "dotenv -e .env.local -- tsx scripts/reset.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
